# Application
APP_NAME=PENTAGON5 ANGEL NIFTY TRIPLE ENGINE
DEBUG=false
HOST=0.0.0.0
PORT=8056

# Angel One SmartAPI (required for live trading)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Database (SQLite default — swap for PostgreSQL later)
DATABASE_URL=sqlite:///./data/pentagon5.db

# Trading
TRADING_MODE=LIVE
LOT_SIZE=65

# Engine allocation defaults (must sum to 100)
NORMAL_ALLOCATION_PCT=30
WICK_ALLOCATION_PCT=30
ULTRA_ALLOCATION_PCT=40

# Dashboard trade confirmation password (required for live entry/exit actions)
DASHBOARD_TRADE_PASSWORD=
